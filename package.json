{
  "name": "medical-aesthetics-psychology-website",
  "version": "1.0.0",
  "description": "Production-ready static website for Medical Aesthetics Consumer Psychology Book",
  "main": "index.html",
  "scripts": {
    "build": "npm run clean && npm run minify-html && npm run minify-css && npm run minify-js && npm run optimize-images && npm run generate-sitemap",
    "build:production": "NODE_ENV=production npm run build",
    "build:development": "NODE_ENV=development npm run build",
    "clean": "rimraf dist/*",
    "minify-html": "htmlminifier --input-dir website --output-dir dist --file-ext html --collapse-whitespace --remove-comments --remove-optional-tags --remove-redundant-attributes --remove-script-type-attributes --remove-tag-whitespace --use-short-doctype --minify-css true --minify-js true",
    "minify-css": "cleancss --batch --batch-suffix '.min' --output dist/assets/css/ 'website/assets/css/*.css'",
    "minify-js": "terser website/assets/js/*.js --compress --mangle --output-dir dist/assets/js/",
    "optimize-images": "imagemin website/assets/svg/**/* --out-dir=dist/assets/svg/ --plugin=svgo",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "serve:development": "npx http-server website -p 8080 -o",
    "serve:production": "npx http-server dist -p 8081 -o",
    "test:lighthouse": "lhci autorun --config=.lighthouserc.js",
    "test:validation": "html-validate website/**/*.html",
    "deploy:preview": "npm run build:production && npm run test:lighthouse",
    "deploy:production": "npm run build:production && npm run test:lighthouse && npm run deploy:netlify",
    "deploy:netlify": "netlify deploy --prod --dir=dist",
    "deploy:vercel": "vercel --prod",
    "analyze": "npm run build && webpack-bundle-analyzer dist/assets/js/",
    "compress": "gzip -k -r dist/ && brotli -k -r dist/"
  },
  "keywords": [
    "medical-aesthetics",
    "psychology",
    "static-website",
    "academic",
    "healthcare",
    "consumer-behavior"
  ],
  "author": "重庆联合丽格科技有限公司",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "autoprefixer": "^10.4.16",
    "brotli": "^1.3.3",
    "clean-css-cli": "^5.6.2",
    "cssnano": "^6.0.1",
    "eslint": "^8.51.0",
    "html-minifier-terser": "^7.2.0",
    "html-validate": "^8.14.0",
    "http-server": "^14.1.1",
    "imagemin": "^8.0.1",
    "imagemin-svgo": "^10.0.1",
    "lightouse-cli": "^0.3.0",
    "netlify-cli": "^17.3.1",
    "postcss": "^8.4.31",
    "postcss-cli": "^10.1.0",
    "rimraf": "^5.0.5",
    "sass": "^1.69.5",
    "sitemap": "^7.1.1",
    "terser": "^5.22.0",
    "vercel": "^32.5.0",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^4.9.1",
    "workbox-cli": "^7.0.0"
  },
  "dependencies": {
    "intersection-observer": "^0.12.2",
    "lazysizes": "^5.3.2",
    "web-vitals": "^3.5.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie <= 11"
  ],
  "engines": {
    "node": ">= 18.0.0",
    "npm": ">= 9.0.0"
  }
}