{
  "version": "2010-08-01",
  "location": {
    "type": "s3",
    "configuration": {
      "bucket": "medical-aesthetics-psychology-website",
      "region": "us-east-1"
    }
  },
  "deployment": {
    "artifact_bucket": "deployment-artifacts",
    "artifact_prefix": "medical-aesthetics-psychology/"
  },
  "cache_config": {
    "cache_control_mappings": [
      {
        "path_pattern": "\\.html$",
        "cache_control": "public, max-age=0, must-revalidate"
      },
      {
        "path_pattern": "\\.css$",
        "cache_control": "public, max-age=31536000, immutable"
      },
      {
        "path_pattern": "\\.js$",
        "cache_control": "public, max-age=31536000, immutable"
      },
      {
        "path_pattern": "\\.(svg|png|jpg|jpeg|webp|avif|gif)$",
        "cache_control": "public, max-age=31536000, immutable"
      },
      {
        "path_pattern": "\\.woff2?$",
        "cache_control": "public, max-age=31536000, immutable"
      },
      {
        "path_pattern": "sitemap\\.xml$|robots\\.txt$",
        "cache_control": "public, max-age=86400"
      }
    ]
  },
  "headers_config": {
    "headers": [
      {
        "path_pattern": "*",
        "headers": [
          {
            "name": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "name": "X-XSS-Protection",
            "value": "1; mode=block"
          },
          {
            "name": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "name": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "name": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      },
      {
        "path_pattern": "\\.(svg|png|jpg|jpeg|webp|avif|gif)$",
        "headers": [
          {
            "name": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ]
  },
  "compression_config": {
    "compress": true,
    "content_types": [
      "text/html",
      "text/css",
      "application/javascript",
      "application/json",
      "text/xml",
      "application/xml",
      "image/svg+xml"
    ]
  }
}